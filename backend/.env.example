# ================================================================================
# TRAVEL WEBSITE - ENVIRONMENT VARIABLES
# ================================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to git (it's in .gitignore)
# ================================================================================

# ================================================================================
# DATABASE CONFIGURATION
# ================================================================================

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/travel-db

# Example:
# MONGODB_URI=mongodb+srv://myuser:mypassword123@cluster0.mongodb.net/travelhub

# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/travel-db

# ================================================================================
# JWT (JSON Web Token) CONFIGURATION
# ================================================================================

# Secret key for JWT token generation
# IMPORTANT: Use a long, random, secure string in production
# Generate one: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# JWT Token Expiration (optional)
JWT_EXPIRE=7d

# ================================================================================
# ADMIN SEED CONFIGURATION
# ================================================================================

# Used by: npm run create-admin
ADMIN_NAME=Example Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_ROLE=admin

# ================================================================================
# SERVER CONFIGURATION
# ================================================================================

# Port for backend server
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development

# ================================================================================
# FRONTEND CONFIGURATION
# ================================================================================

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# For production:
# FRONTEND_URL=https://yourdomain.com

# ================================================================================
# OPTIONAL: EMAIL CONFIGURATION (for future use)
# ================================================================================

# Uncomment and configure if you want to send emails
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ================================================================================
# OPTIONAL: CLOUDINARY (for image uploads)
# ================================================================================

# Uncomment if using Cloudinary for image storage
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ================================================================================
# OPTIONAL: PAYMENT GATEWAY (Stripe)
# ================================================================================

# Uncomment if integrating Stripe payments
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_PUBLIC_KEY=your-stripe-public-key

# ================================================================================
